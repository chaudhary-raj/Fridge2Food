# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Python virtual environments & cache
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Environment variables & secrets (NEVER commit actual secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
inference-service/.env

# Model weights (large binary files supplied locally by user)
models/*.pt
models/*.onnx
models/*.engine
!models/README.md

# Temporary session uploads & runtime storage
temp_sessions/
backend/temp_sessions/
inference-service/temp_uploads/
uploads/
tmp/
*.tmp

# Build outputs
dist/
build/
frontend/dist/
coverage/

# Logs & OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
